# =============================================================================
# SIAKAD NUJA — Template variabel lingkungan untuk RAILWAY
#
# Salin isi file ini ke Railway > service "app" > Variables.
# Sintaks ${{MySQL.XXX}} otomatis mengambil nilai dari service database
# bernama "MySQL" (sesuaikan nama referensinya dengan nama service DB Anda).
# =============================================================================

APP_NAME=SiakadNuja
APP_ENV=production
APP_DEBUG=false
# Ganti setelah domain dibuat, contoh: https://siakad-nuja.up.railway.app
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# >>> WAJIB: generate sekali di lokal `php artisan key:generate --show`
# >>> lalu tempel hasilnya DI SINI (jangan dibiarkan kosong!)
APP_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---- Database (Railway MySQL) -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ---- Session / cache / queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Railway mem-proxy HTTPS -> HTTP; Laravel harus mempercayai proxy-nya
TRUSTED_PROXIES=*

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@siakadnuja.sch.id
MAIL_FROM_NAME="${APP_NAME}"

# ---- WhatsApp sidecar (kstmostofa/laravel-whatsapp) --------------------------
WHATSAPP_WEB_ENABLED=true
# Sidecar & Laravel berada dalam container yang sama -> selalu loopback.
# JANGAN ganti ke 0.0.0.0 dan JANGAN expose port ini ke publik.
WHATSAPP_WEB_HOST=127.0.0.1
WHATSAPP_WEB_PORT=3000
# >>> WAJIB diganti: token acak minimal 32 karakter (mis. `openssl rand -hex 32`)
WHATSAPP_WEB_TOKEN=
WHATSAPP_WEB_NODE_BINARY=/usr/local/bin/node
WHATSAPP_WEB_NPM_BINARY=/usr/local/bin/npm

# Panel admin WA bawaan paket (/whatsapp) — matikan jika hanya pakai panel kustom
WHATSAPP_UI_ENABLED=false
# CSS pre-compiled milik paket (tidak perlu pipeline Tailwind tambahan)
WHATSAPP_UI_CSS_MODE=standalone

WHATSAPP_WEB_AUTO_START_SESSIONS=true
WHATSAPP_SESSION_ID=main

# ---- Kendali entrypoint -------------------------------------------------------
RUN_MIGRATIONS=true
START_QUEUE=true
START_SIDECAR=true
DB_WAIT_TIMEOUT=90
PHP_CLI_SERVER_WORKERS=8

TZ=Asia/Jakarta
